# Fully client-side config (PUBLIC_ vars are inlined into the browser bundle).

# Audit data source: "osm" (default, free, no key) or "google" (real Google Places).
PUBLIC_AUDIT_DATA_SOURCE="osm"
# Only needed when PUBLIC_AUDIT_DATA_SOURCE=google. Restrict by HTTP referrer!
PUBLIC_GOOGLE_PLACES_API_KEY=""

# Firebase project config (public by design; secured via firestore.rules).
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_DATABASE_URL=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_APP_ID=""
