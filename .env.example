# PostgreSQL connection. Local dev points at the local Postgres; on Render this
# is provided automatically when you attach a Postgres instance (postgres:// form
# is auto-normalized in src/lib/server/db.js).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jhax_landing"
CORS_ORIGINS="*"
# Audit data source: "osm" (default, OpenStreetMap Nominatim, no key needed) or
# "google" (real Google Places — also set GOOGLE_PLACES_API_KEY below).
AUDIT_DATA_SOURCE="osm"
# Optional: overrides the Nominatim User-Agent (must identify you + contact per policy).
# NOMINATIM_USER_AGENT="JHAX-Audit-Tool/1.0 (contact: you@example.com)"
# Google Places API (New) key — only used when AUDIT_DATA_SOURCE=google.
GOOGLE_PLACES_API_KEY=""
